{
  "name": "arcana-rattus",
  "private": true,
  "version": "0.1.0",
  "description": "Fullscreen rat-themed tarot reading overlay for stream capture.",
  "author": "Tanaki",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:build": "vite build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.tanakisa.arcanarattus",
    "productName": "Arcana Rattus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Arcana-Rattus-${version}-portable-${arch}.${ext}"
    }
  }
}
